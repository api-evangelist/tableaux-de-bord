{
  "opencollection": "1.0.0",
  "info": {
    "name": "Grafana Dashboard Alerting Folders API",
    "version": "10.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Folders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Folders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{grafana-host}/api/folders"
          },
          "docs": "Get all folders in the current organization."
        },
        {
          "info": {
            "name": "Create Folder",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{grafana-host}/api/folders",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new folder for organizing dashboards."
        }
      ]
    }
  ],
  "bundled": true
}