{
  "opencollection": "1.0.0",
  "info": {
    "name": "Grafana Dashboard Alerting API",
    "version": "10.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Alerting",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Alert Rules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{grafana-host}/api/v1/provisioning/alert-rules"
          },
          "docs": "Get all Grafana alerting rules."
        },
        {
          "info": {
            "name": "Create Alert Rule",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{grafana-host}/api/v1/provisioning/alert-rules",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new Grafana alerting rule."
        }
      ]
    }
  ],
  "bundled": true
}